# Sample environment file for the Archon sandbox runner.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored
# (see .gitignore) — never commit it. Real secrets live only on
# developer machines and in GitHub Actions secrets.
#
# Loaded automatically by `scripts/sandbox-run.mjs` via Node's built-in
# `--env-file` support (Node ≥ 20.6) — no `dotenv` package required.

# ──────────────────────────────────────────────────────────────────────
# Cursor SDK — required for the agent install scenario (row 19,
# `install-agent-cursor`). Without it the runner records `result: manual`
# via `cursor.mjs::isAvailable()` and exits zero.
#
# Get a key at https://cursor.com/dashboard/integrations
# ──────────────────────────────────────────────────────────────────────
CURSOR_API_KEY=crsr_replace_me_with_your_real_key

# Optional overrides for the Cursor agent provider:
# ARCHON_AGENT_MODEL=composer-2          # default model id
# ARCHON_AGENT_TIMEOUT_MS=600000          # 10 min wall-clock per agent step
# ARCHON_AGENT_PROVIDER=cursor            # force a specific provider
